{
  "projectId": "your-t3-project-id",
  "orchestrator": "orchestrator-thread-id",
  "workspace": "/absolute/project/path",
  "branch": "main",
  "github": {
    "repo": "owner/name",
    "requiredChecks": [
      "acceptance"
    ]
  },
  "checks": [
    {
      "name": "tests",
      "argv": [
        "npm",
        "test"
      ],
      "cwd": ".",
      "timeoutSeconds": 900
    }
  ],
  "defaults": {
    "implementer": "gpt-6.2-sol",
    "implementerEffort": "xhigh",
    "reviewer": "claude-opus-5-5",
    "reviewerEffort": "xhigh",
    "devops": "claude-sonnet-5-5",
    "devopsEffort": "high"
  },
  "models": {
    "claude-haiku-5-5": {
      "provider": "claudeAgent",
      "roles": [
        "implementer",
        "reviewer"
      ]
    },
    "gpt-6.2-sol": {
      "provider": "codex",
      "roles": [
        "implementer"
      ]
    },
    "claude-sonnet-5-5": {
      "provider": "claudeAgent",
      "roles": [
        "reviewer",
        "devops"
      ]
    },
    "gpt-6.2-astra": {
      "provider": "codex",
      "roles": [
        "implementer"
      ]
    },
    "claude-opus-5-5": {
      "provider": "claudeAgent",
      "roles": [
        "reviewer",
        "devops"
      ]
    },
    "gemini-4-neon": {
      "provider": "antigravity",
      "roles": [
        "implementer",
        "reviewer",
        "devops"
      ]
    },
    "deepseek/deepseek-v4.1-flash-1017": {
      "provider": "acpRegistry_goose",
      "roles": [
        "implementer",
        "reviewer"
      ]
    },
    "z-ai/glm-5.3-prime": {
      "provider": "acpRegistry_goose",
      "roles": [
        "implementer",
        "reviewer",
        "devops"
      ]
    }
  },
  "jev": {
    "model": "jev-1.13.0",
    "keyEnv": "TYPESAFE_API_KEY",
    "keyFile": "secrets/typesafe-api-key.txt"
  },
  "quietMinutes": 30
}
