{
  "projectId": "your-t3-project-id",
  "orchestrator": "orchestrator-thread-id",
  "workspace": "/absolute/project/path",
  "branch": "main",
  "github": {
    "repo": "owner/name",
    "requiredChecks": [
      "acceptance"
    ]
  },
  "checks": [
    {
      "name": "tests",
      "argv": [
        "npm",
        "test"
      ],
      "cwd": ".",
      "timeoutSeconds": 900
    }
  ],
  "defaults": {
    "implementerEffort": "xhigh",
    "reviewer": "gpt-6.2-astra",
    "reviewerEffort": "xhigh",
    "devops": "claude-sonnet-5-5",
    "devopsEffort": "high",
    "lead": "claude-fable-5-2",
    "leadEffort": "high"
  },
  "jev": {
    "model": "jev-1.13.0",
    "keyEnv": "TYPESAFE_API_KEY",
    "keyFile": "secrets/typesafe-api-key.txt"
  },
  "quietMinutes": 30
}
